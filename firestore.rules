// Firestore Security Rules for the wealth-architecht project.
//
// State of the codebase: single-user app with no auth. The website writes
// the user's category rules and per-transaction overrides to a single doc
// at /config/default so the Vercel weekly-summary Function can read them
// and apply the same categorization view as the website.
//
// The /config/default doc allows public read+write because there is no
// auth wired in yet. When auth lands, tighten this to:
//   match /config/default {
//     allow read, write: if request.auth != null && request.auth.uid == 'YOUR_UID';
//   }
//
// All other paths remain locked so accidental writes to other collections
// can't happen.
//
// To deploy: firebase deploy --only firestore:rules
// (firebase.json and .firebaserc are checked in and point at wealth-architecht).
// Or paste into Firebase Console → Firestore Database → Rules → Publish.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/default {
      allow read, write: if true;
    }
    match /budgets/{doc=**} {
      allow read, write: if true;
    }
    // Daily portfolio snapshots. Written only by the server cron through the
    // Admin SDK, which bypasses these rules, so the browser needs read alone —
    // a stray client write can't corrupt the history.
    match /portfolioHistory/{doc} {
      allow read: if true;
      allow write: if false;
    }
    // Purchase alerts pushed from the phone by a Shortcuts automation, through
    // api/spend-alert. The server writes them with the Admin SDK, which bypasses
    // these rules; the browser needs write as well as read because choosing a
    // category for an alert, and marking it applied, both happen on the device.
    // Open like /config/default for the same reason — there is no auth yet.
    match /spendAlerts/{doc} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
