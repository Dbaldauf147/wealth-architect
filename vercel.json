{
  "crons": [
    {
      "path": "/api/weekly-summary",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/payment-reminder",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/calendar-sync",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/portfolio-snapshot",
      "schedule": "0 22 * * 1-5"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
